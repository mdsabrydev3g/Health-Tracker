# ===== قاعدة البيانات (Neon Postgres) =====
# من لوحة Neon: Dashboard → Connection String (pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/health_tracker?sslmode=require"

# ===== حساب مقدم الرعاية (حساب واحد فقط للتطبيق العائلي) =====
CAREGIVER_EMAIL="caregiver@example.com"
# كلمة المرور مخزنة كـ hash بصيغة PBKDF2: iterations:salt:hash
# ولّدها بـ: npm run hash:password -- "كلمة_المرور"
CAREGIVER_PASSWORD_HASH=""
# مفتاح توقيع الجلسات — ولّدها بأي مولد عشوائي 64 حرف hex
AUTH_SECRET=""

# ===== اختياري: التوقيت الافتراضي =====
DEFAULT_TIMEZONE="Africa/Cairo"
