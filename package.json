{
  "name": "health-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Health Tracker — تطبيق عائلي لتتبع الأدوية والصحة (العناية بالوالدة)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "hash:password": "tsx scripts/hash-password.ts",
    "cap:sync": "next build && cap sync android",
    "cap:open": "cap open android",
    "cap:add": "cap add android"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/preferences": "^6.0.2",
    "@neondatabase/serverless": "^0.9.5",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "drizzle-orm": "^0.33.0",
    "jose": "^5.9.3",
    "jsqr": "^1.4.0",
    "next": "14.2.15",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@types/node": "^20.16.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.10",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.24.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
